{
  "name": "finledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "VITE_BACKEND=1 vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:pages": "tsc -b && VITE_ROUTER=hash vite build --base ./",
    "build:backend": "tsc -b && VITE_BACKEND=1 vite build",
    "server:dev": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "server:build": "esbuild server/src/index.ts server/src/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --tsconfig=server/tsconfig.json --outdir=dist-server --out-extension:.js=.mjs",
    "server:start": "node dist-server/index.mjs",
    "db:migrate": "tsx --tsconfig server/tsconfig.json server/src/cli.ts migrate",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/src/cli.ts seed-demo",
    "db:create-firm": "tsx --tsconfig server/tsconfig.json server/src/cli.ts create-firm",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:server": "vitest run --config server/vitest.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.460.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
